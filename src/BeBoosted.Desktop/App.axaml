<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:desktop="using:BeBoosted.Desktop"
             x:Class="BeBoosted.Desktop.App"
             RequestedThemeVariant="Light">
  <!-- BeBoosted is light-only by design (Academic Workbench). -->

  <Application.DataTemplates>
    <desktop:ViewLocator />
  </Application.DataTemplates>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Styles/Tokens.axaml" />
        <ResourceInclude Source="/Styles/Typography.axaml" />
        <ResourceInclude Source="/Styles/Icons.axaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- Repaint Fluent's accent (used by TextBox focus, pickers, etc.) in graphite so
           stock controls stay on the Academic Workbench palette. -->
      <Color x:Key="SystemAccentColor">#20231F</Color>
      <Color x:Key="SystemAccentColorDark1">#20231F</Color>
      <Color x:Key="SystemAccentColorDark2">#191C18</Color>
      <Color x:Key="SystemAccentColorDark3">#121411</Color>
      <Color x:Key="SystemAccentColorLight1">#3A3E38</Color>
      <Color x:Key="SystemAccentColorLight2">#565B53</Color>
      <Color x:Key="SystemAccentColorLight3">#73776E</Color>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="/Styles/Controls.axaml" />
  </Application.Styles>

</Application>
