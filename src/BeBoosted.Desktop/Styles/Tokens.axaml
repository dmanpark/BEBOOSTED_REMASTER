<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    BeBoosted design tokens — Academic Workbench palette.
    Core six colors come from the approved spec; the extended set formalizes
    colors observed in the Claude Design frames (folio underlay, synced-event
    cream gray, muted project accents, hover-ink green).
  -->

  <!-- Core palette -->
  <Color x:Key="ColorPaperWhite">#FCFCF8</Color>
  <Color x:Key="ColorWorkbenchCream">#F2EEDB</Color>
  <Color x:Key="ColorGraphite">#20231F</Color>
  <Color x:Key="ColorPencilGray">#73776E</Color>
  <Color x:Key="ColorHighlighterLime">#C8F24A</Color>
  <Color x:Key="ColorLimeWash">#EDF8C8</Color>

  <!-- Extended semantic colors -->
  <Color x:Key="ColorSyncedCream">#ECE9DC</Color>
  <Color x:Key="ColorFolioUnderlay">#F6F3E4</Color>
  <Color x:Key="ColorInkHover">#5A6B1E</Color>
  <Color x:Key="ColorAccentUmber">#C2803F</Color>
  <Color x:Key="ColorAccentSlate">#7B8FA6</Color>

  <!-- Graphite rules and borders (alpha ramp over #20231F) -->
  <Color x:Key="ColorRuleFaint">#1420231F</Color>
  <!-- 8% -->
  <Color x:Key="ColorRuleLight">#1A20231F</Color>
  <!-- 10% -->
  <Color x:Key="ColorRuleDefault">#1F20231F</Color>
  <!-- 12% -->
  <Color x:Key="ColorRuleMedium">#2620231F</Color>
  <!-- 15% -->
  <Color x:Key="ColorBorderDefault">#3320231F</Color>
  <!-- 20% -->
  <Color x:Key="ColorBorderStrong">#4020231F</Color>
  <!-- 25% -->
  <Color x:Key="ColorBorderEmphasis">#4D20231F</Color>
  <!-- 30% -->
  <Color x:Key="ColorGraphite40">#6620231F</Color>
  <Color x:Key="ColorGraphite55">#8C20231F</Color>
  <Color x:Key="ColorHoverWash">#1220231F</Color>
  <!-- 7% graphite hover fill -->
  <Color x:Key="ColorLimeHalo">#8CC8F24A</Color>

  <!-- Brushes -->
  <SolidColorBrush x:Key="BrushPaperWhite" Color="{StaticResource ColorPaperWhite}" />
  <SolidColorBrush x:Key="BrushWorkbenchCream" Color="{StaticResource ColorWorkbenchCream}" />
  <SolidColorBrush x:Key="BrushGraphite" Color="{StaticResource ColorGraphite}" />
  <SolidColorBrush x:Key="BrushPencilGray" Color="{StaticResource ColorPencilGray}" />
  <SolidColorBrush x:Key="BrushHighlighterLime" Color="{StaticResource ColorHighlighterLime}" />
  <SolidColorBrush x:Key="BrushLimeWash" Color="{StaticResource ColorLimeWash}" />
  <SolidColorBrush x:Key="BrushSyncedCream" Color="{StaticResource ColorSyncedCream}" />
  <SolidColorBrush x:Key="BrushFolioUnderlay" Color="{StaticResource ColorFolioUnderlay}" />
  <SolidColorBrush x:Key="BrushInkHover" Color="{StaticResource ColorInkHover}" />
  <SolidColorBrush x:Key="BrushAccentUmber" Color="{StaticResource ColorAccentUmber}" />
  <SolidColorBrush x:Key="BrushAccentSlate" Color="{StaticResource ColorAccentSlate}" />
  <SolidColorBrush x:Key="BrushRuleFaint" Color="{StaticResource ColorRuleFaint}" />
  <SolidColorBrush x:Key="BrushRuleLight" Color="{StaticResource ColorRuleLight}" />
  <SolidColorBrush x:Key="BrushRuleDefault" Color="{StaticResource ColorRuleDefault}" />
  <SolidColorBrush x:Key="BrushRuleMedium" Color="{StaticResource ColorRuleMedium}" />
  <SolidColorBrush x:Key="BrushBorderDefault" Color="{StaticResource ColorBorderDefault}" />
  <SolidColorBrush x:Key="BrushBorderStrong" Color="{StaticResource ColorBorderStrong}" />
  <SolidColorBrush x:Key="BrushBorderEmphasis" Color="{StaticResource ColorBorderEmphasis}" />
  <SolidColorBrush x:Key="BrushGraphite40" Color="{StaticResource ColorGraphite40}" />
  <SolidColorBrush x:Key="BrushGraphite55" Color="{StaticResource ColorGraphite55}" />
  <SolidColorBrush x:Key="BrushHoverWash" Color="{StaticResource ColorHoverWash}" />

  <!-- Geometry: modest radii, never pills for containers -->
  <CornerRadius x:Key="RadiusSmall">4</CornerRadius>
  <CornerRadius x:Key="RadiusControl">6</CornerRadius>
  <CornerRadius x:Key="RadiusButton">7</CornerRadius>
  <CornerRadius x:Key="RadiusPanel">9</CornerRadius>
  <CornerRadius x:Key="RadiusDrawer">10</CornerRadius>

  <!-- Spacing (4px base grid) -->
  <x:Double x:Key="SpaceXs">4</x:Double>
  <x:Double x:Key="SpaceSm">8</x:Double>
  <x:Double x:Key="SpaceMd">12</x:Double>
  <x:Double x:Key="SpaceLg">16</x:Double>
  <x:Double x:Key="SpaceXl">24</x:Double>

  <!-- Shadows: flat calendar surfaces; depth is reserved for drawers, popovers, and Files -->
  <BoxShadows x:Key="ShadowSubtle">0 1 3 0 #0F20231F</BoxShadows>
  <BoxShadows x:Key="ShadowPanel">0 12 30 0 #2E20231F</BoxShadows>
  <BoxShadows x:Key="ShadowDrawer">0 14 36 0 #3320231F</BoxShadows>
  <BoxShadows x:Key="ShadowFolio">0 2 5 0 #1A20231F</BoxShadows>

</ResourceDictionary>
