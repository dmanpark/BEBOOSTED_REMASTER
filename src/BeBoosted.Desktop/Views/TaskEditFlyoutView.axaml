<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BeBoosted.Desktop.ViewModels"
             x:Class="BeBoosted.Desktop.Views.TaskEditFlyoutView"
             x:DataType="vm:TaskRowViewModel">

  <!-- The one task-edit form, shared by the Inbox drawer and the Daily list.
       Lives inside a Flyout; Save/Delete close the hosting popup. -->
  <StackPanel Width="264" Spacing="10" Margin="4">
    <TextBlock Text="Edit task" FontWeight="SemiBold" />
    <TextBox Text="{Binding EditTitle}" PlaceholderText="Title"
             AutomationProperties.Name="Task title" />
    <DockPanel>
      <TextBlock Classes="metaLabel" Text="DEADLINE" Width="82"
                 VerticalAlignment="Center" />
      <DatePicker SelectedDate="{Binding EditDeadline}"
                  AutomationProperties.Name="Deadline" />
    </DockPanel>
    <DockPanel>
      <TextBlock Classes="metaLabel" Text="DURATION" Width="82"
                 VerticalAlignment="Center" />
      <NumericUpDown Value="{Binding EditDurationMinutes}"
                     Minimum="5" Maximum="720" Increment="5"
                     FormatString="0"
                     PlaceholderText="minutes"
                     AutomationProperties.Name="Estimated minutes" />
    </DockPanel>
    <DockPanel>
      <TextBlock Classes="metaLabel" Text="PROJECT" Width="82"
                 VerticalAlignment="Center" />
      <ComboBox ItemsSource="{Binding ProjectChoices}"
                SelectedItem="{Binding EditProject}"
                HorizontalAlignment="Stretch"
                AutomationProperties.Name="Project">
        <ComboBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ProjectChoiceViewModel">
            <TextBlock Text="{Binding Name}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
    </DockPanel>
    <DockPanel Margin="0,4,0,0">
      <Button DockPanel.Dock="Right" Classes="primary" Content="Save"
              Command="{Binding CommitEditCommand}"
              Click="OnEditActionClick" />
      <Button Content="Delete"
              Command="{Binding DeleteCommand}"
              Click="OnEditActionClick"
              HorizontalAlignment="Left" />
    </DockPanel>
  </StackPanel>

</UserControl>
