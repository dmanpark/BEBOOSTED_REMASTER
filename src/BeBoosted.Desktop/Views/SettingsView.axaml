<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BeBoosted.Desktop.ViewModels"
             x:Class="BeBoosted.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <UserControl.Styles>
    <!-- Local focus ring for the capture model card's text fields and buttons,
         matching the editor views' scoped focusRing idiom. -->
    <Style Selector="Border.focusRing">
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
    </Style>
    <Style Selector="Border.focusRing:focus-within">
      <Setter Property="BorderBrush" Value="{DynamicResource BrushGraphite}" />
      <Setter Property="BoxShadow" Value="0 0 0 5 #8CC8F24A" />
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <Border DockPanel.Dock="Top" Height="52"
            BorderBrush="{StaticResource BrushRuleDefault}"
            BorderThickness="0,0,0,1">
      <TextBlock Text="Settings" Margin="18,0" VerticalAlignment="Center"
                 FontWeight="SemiBold" />
    </Border>

    <ScrollViewer>
    <StackPanel Width="640" HorizontalAlignment="Center" Margin="0,40,0,40" Spacing="26">
      <StackPanel Spacing="6">
        <TextBlock Text="AI permissions" FontSize="{StaticResource TextSizeSectionTitle}"
                   FontWeight="SemiBold" />
        <TextBlock Classes="secondary"
                   Text="Each permission is separate. Letting BeBoosted add tasks never lets it change your calendar."
                   TextWrapping="Wrap" />
      </StackPanel>

      <!-- Capture model -->
      <Border Background="{StaticResource BrushPaperWhite}"
              BorderBrush="{StaticResource BrushRuleMedium}" BorderThickness="1"
              CornerRadius="{StaticResource RadiusPanel}" Padding="24,20">
        <StackPanel Spacing="13">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="Capture model" FontSize="{StaticResource TextSizeHeading}"
                       FontWeight="SemiBold" />
            <TextBlock Classes="meta" Text="which parser reads your message" VerticalAlignment="Center" />
          </StackPanel>

          <RadioButton GroupName="captureModel" IsChecked="{Binding IsCaptureHeuristic}"
                       AutomationProperties.Name="Built-in capture">
            <StackPanel Spacing="2">
              <TextBlock Text="Built-in rules" FontWeight="SemiBold" />
              <TextBlock Classes="secondary" FontSize="{StaticResource TextSizeSmall}"
                         Text="No model involved. Works offline, every time."
                         TextWrapping="Wrap" />
            </StackPanel>
          </RadioButton>

          <RadioButton GroupName="captureModel" IsChecked="{Binding IsCaptureOllama}"
                       AutomationProperties.Name="Ollama capture">
            <StackPanel Spacing="2">
              <TextBlock Text="Ollama, running locally" FontWeight="Medium" />
              <TextBlock Classes="secondary" FontSize="{StaticResource TextSizeSmall}"
                         Text="A model on this computer reads your message."
                         TextWrapping="Wrap" />
            </StackPanel>
          </RadioButton>
          <StackPanel Spacing="10" Margin="30,0,0,0" IsVisible="{Binding IsCaptureOllama}">
            <StackPanel Spacing="6">
              <TextBlock Classes="metaLabel" Text="ENDPOINT" />
              <Border Classes="focusRing">
                <TextBox Text="{Binding OllamaEndpoint}"
                         AutomationProperties.Name="Ollama endpoint" />
              </Border>
            </StackPanel>
            <StackPanel Spacing="6">
              <TextBlock Classes="metaLabel" Text="MODEL" />
              <Border Classes="focusRing">
                <TextBox Text="{Binding OllamaModel}"
                         AutomationProperties.Name="Ollama model" />
              </Border>
            </StackPanel>
          </StackPanel>

          <RadioButton GroupName="captureModel" IsChecked="{Binding IsCaptureClaude}"
                       IsEnabled="{Binding CanUseClaude}"
                       AutomationProperties.Name="Claude capture">
            <StackPanel Spacing="2">
              <TextBlock Text="Claude" FontWeight="Medium" />
              <TextBlock Classes="secondary" FontSize="{StaticResource TextSizeSmall}"
                         Text="A cloud model reads your message. Most capable, but it leaves the machine."
                         TextWrapping="Wrap" />
            </StackPanel>
          </RadioButton>
          <TextBlock Classes="secondary" FontSize="{StaticResource TextSizeSmall}"
                     Text="{Binding UnavailableKeyNotice}" IsVisible="{Binding !CanUseClaude}"
                     Margin="30,0,0,0" TextWrapping="Wrap" />
          <StackPanel Spacing="10" Margin="30,0,0,0" IsVisible="{Binding IsCaptureClaude}">
            <StackPanel Spacing="6">
              <TextBlock Classes="metaLabel" Text="MODEL" />
              <Border Classes="focusRing">
                <TextBox Text="{Binding ClaudeModel}"
                         AutomationProperties.Name="Claude model" />
              </Border>
            </StackPanel>
            <StackPanel Spacing="6">
              <TextBlock Classes="metaLabel" Text="API KEY" />
              <Border Classes="focusRing">
                <TextBox Text="{Binding ApiKeyEntry}" PasswordChar="•"
                         PlaceholderText="sk-ant-..."
                         AutomationProperties.Name="Claude API key" />
              </Border>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Border Classes="focusRing">
                  <Button Content="Save" Command="{Binding SaveApiKeyCommand}"
                          AutomationProperties.Name="Save API key" />
                </Border>
                <Border Classes="focusRing">
                  <Button Content="Remove" Command="{Binding RemoveApiKeyCommand}"
                          IsEnabled="{Binding HasSavedKey}"
                          AutomationProperties.Name="Remove API key" />
                </Border>
                <TextBlock Classes="meta" Text="Key saved" VerticalAlignment="Center"
                           IsVisible="{Binding HasSavedKey}" />
              </StackPanel>
            </StackPanel>
          </StackPanel>

          <StackPanel Orientation="Horizontal" Spacing="8">
            <Path Classes="icon" Data="{StaticResource IconLock}" Width="12" Height="12"
                  StrokeThickness="1.3" Stroke="{StaticResource BrushPencilGray}"
                  VerticalAlignment="Center" />
            <TextBlock Classes="secondary" FontSize="{StaticResource TextSizeSmall}"
                       Text="{Binding ConsentText}" TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Task capture -->
      <Border Background="{StaticResource BrushPaperWhite}"
              BorderBrush="{StaticResource BrushRuleMedium}" BorderThickness="1"
              CornerRadius="{StaticResource RadiusPanel}" Padding="24,20">
        <StackPanel Spacing="13">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="Task capture" FontSize="{StaticResource TextSizeHeading}"
                       FontWeight="SemiBold" />
            <TextBlock Classes="meta" Text="what enters your Inbox" VerticalAlignment="Center" />
          </StackPanel>
          <RadioButton GroupName="taskCapture" IsChecked="{Binding IsTaskCaptureReview}"
                       AutomationProperties.Name="Review before adding">
            <StackPanel Spacing="2">
              <TextBlock Text="Review before adding" FontWeight="SemiBold" />
              <TextBlock Classes="secondary" FontSize="{StaticResource TextSizeSmall}"
                         Text="Suggested tasks wait in a review list until you approve them."
                         TextWrapping="Wrap" />
            </StackPanel>
          </RadioButton>
          <RadioButton GroupName="taskCapture" IsChecked="{Binding IsTaskCaptureAuto}"
                       AutomationProperties.Name="Add automatically and label AI added">
            <StackPanel Spacing="2">
              <TextBlock Text="Add automatically and label AI added" FontWeight="Medium" />
              <TextBlock Classes="secondary" FontSize="{StaticResource TextSizeSmall}"
                         Text="Tasks join the Inbox immediately and keep their origin and sources."
                         TextWrapping="Wrap" />
            </StackPanel>
          </RadioButton>
        </StackPanel>
      </Border>

      <!-- Calendar planning -->
      <Border Background="{StaticResource BrushPaperWhite}"
              BorderBrush="{StaticResource BrushRuleMedium}" BorderThickness="1"
              CornerRadius="{StaticResource RadiusPanel}" Padding="24,20">
        <StackPanel Spacing="13">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="Calendar planning" FontSize="{StaticResource TextSizeHeading}"
                       FontWeight="SemiBold" />
            <TextBlock Classes="meta" Text="what lands on your time" VerticalAlignment="Center" />
          </StackPanel>
          <RadioButton GroupName="calendarPlanning" IsChecked="{Binding IsPlanningReview}"
                       AutomationProperties.Name="Review every plan">
            <StackPanel Spacing="2">
              <TextBlock Text="Review every plan" FontWeight="SemiBold" />
              <TextBlock Classes="secondary" FontSize="{StaticResource TextSizeSmall}"
                         Text="Plans appear as draft proposals on the calendar until you approve them."
                         TextWrapping="Wrap" />
            </StackPanel>
          </RadioButton>
          <RadioButton GroupName="calendarPlanning" IsChecked="{Binding IsPlanningAuto}"
                       AutomationProperties.Name="Apply plans automatically">
            <StackPanel Spacing="2">
              <TextBlock Text="Apply plans automatically" FontWeight="Medium" />
              <TextBlock Classes="secondary" FontSize="{StaticResource TextSizeSmall}"
                         Text="Blocks are placed without review. Every block stays labeled and undoable."
                         TextWrapping="Wrap" />
            </StackPanel>
          </RadioButton>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Path Classes="icon" Data="{StaticResource IconLock}" Width="12" Height="12"
                  StrokeThickness="1.3" Stroke="{StaticResource BrushPencilGray}"
                  VerticalAlignment="Center" />
            <TextBlock Classes="secondary" FontSize="{StaticResource TextSizeSmall}"
                       Text="Separate from task capture — turning that on does not change this."
                       TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- External events (future) -->
      <Border Background="{StaticResource BrushPaperWhite}" Opacity="0.75"
              BorderBrush="{StaticResource BrushBorderEmphasis}" BorderThickness="1"
              CornerRadius="{StaticResource RadiusPanel}" Padding="24,20">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="External events" FontSize="{StaticResource TextSizeHeading}"
                       FontWeight="SemiBold" Foreground="{StaticResource BrushPencilGray}" />
            <Border Background="{StaticResource BrushWorkbenchCream}"
                    BorderBrush="{StaticResource BrushBorderDefault}" BorderThickness="1"
                    CornerRadius="3" Padding="7,2" VerticalAlignment="Center">
              <TextBlock Classes="meta" Text="Coming later" />
            </Border>
          </StackPanel>
          <TextBlock Classes="secondary" FontSize="{StaticResource TextSizeSmall}"
                     Text="Read-only availability from a connected calendar. BeBoosted will see busy time but never edit outside events."
                     TextWrapping="Wrap" />
          <RadioButton IsEnabled="False" GroupName="externalEvents"
                       AutomationProperties.Name="Read availability from connected calendars (coming later)">
            <TextBlock Classes="secondary" Text="Read availability from connected calendars" />
          </RadioButton>
        </StackPanel>
      </Border>

      <Border Background="{StaticResource BrushPaperWhite}"
              BorderBrush="{StaticResource BrushRuleMedium}" BorderThickness="1"
              CornerRadius="{StaticResource RadiusPanel}" Padding="24,20">
        <StackPanel Spacing="13">
          <TextBlock Text="About" FontSize="{StaticResource TextSizeHeading}" FontWeight="SemiBold" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="metaLabel" Text="VERSION" Width="110" VerticalAlignment="Center" />
            <TextBlock Classes="mono" Text="{Binding Version}" FontSize="{StaticResource TextSizeSmall}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="metaLabel" Text="DATA LOCATION" Width="110" VerticalAlignment="Center" />
            <TextBlock Classes="mono" Text="{Binding DataDirectory}"
                       FontSize="{StaticResource TextSizeSmall}" TextWrapping="Wrap" />
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
    </ScrollViewer>
  </DockPanel>

</UserControl>
