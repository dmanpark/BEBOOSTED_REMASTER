<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BeBoosted.Desktop.ViewModels"
             xmlns:views="using:BeBoosted.Desktop.Views"
             x:Class="BeBoosted.Desktop.Views.CalendarView"
             x:DataType="vm:CalendarViewModel">

  <Panel>

  <DockPanel>

    <!-- Compact top bar: date navigation and the Today/Week switch -->
    <Border DockPanel.Dock="Top" Height="52"
            BorderBrush="{StaticResource BrushRuleDefault}"
            BorderThickness="0,0,0,1">
      <DockPanel Margin="18,0" VerticalAlignment="Center">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Button Classes="outlineIcon"
                    Command="{Binding GoPreviousCommand}"
                    AutomationProperties.Name="Previous">
              <Path Classes="icon" Data="{StaticResource IconChevronLeft}" Width="12" Height="12"
                    StrokeThickness="1.5" />
            </Button>
            <Button Classes="outlineIcon"
                    Command="{Binding GoNextCommand}"
                    AutomationProperties.Name="Next">
              <Path Classes="icon" Data="{StaticResource IconChevronRight}" Width="12" Height="12"
                    StrokeThickness="1.5" />
            </Button>
          </StackPanel>
          <Button Height="28" Padding="12,0"
                  Command="{Binding GoToTodayCommand}"
                  Content="Today" FontWeight="Medium" Background="Transparent" />
          <TextBlock Text="{Binding HeaderTitle}"
                     FontSize="{StaticResource TextSizeHeading}" FontWeight="SemiBold"
                     VerticalAlignment="Center" />
          <TextBlock Classes="meta" Text="{Binding HeaderMeta}" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10"
                    HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Name="NewCommitmentButton" Height="28" Padding="12,0"
                  Content="New commitment"
                  Command="{Binding OpenNewCommitmentEditorCommand}"
                  AutomationProperties.Name="New fixed commitment" />

          <Border Classes="segmentGroup" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <RadioButton Classes="segment" GroupName="calendarView" Content="Today"
                           IsChecked="{Binding IsTodayView}"
                           AutomationProperties.Name="Today view" />
              <Border Width="1" Background="{StaticResource BrushBorderEmphasis}" />
              <RadioButton Classes="segment" GroupName="calendarView" Content="Week"
                           IsChecked="{Binding IsWeekView}"
                           AutomationProperties.Name="Week view" />
            </StackPanel>
          </Border>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Quiet review notice -->
    <Border DockPanel.Dock="Top"
            IsVisible="{Binding HasReviewNotice}"
            Background="{StaticResource BrushWorkbenchCream}"
            BorderBrush="{StaticResource BrushRuleMedium}" BorderThickness="0,0,0,1"
            Padding="18,7">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Text="{Binding ReviewNoticeText}" VerticalAlignment="Center"
                   FontSize="{StaticResource TextSizeSmall}" />
        <Button Height="26" Padding="10,0" Content="Review" FontWeight="SemiBold"
                AutomationProperties.Name="Review blocks needing an outcome">
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedLeft" ShowMode="Standard">
              <ItemsControl ItemsSource="{Binding ReviewBlocks}" Width="316" Margin="2">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CalendarBlockViewModel">
                    <Border BorderBrush="{StaticResource BrushRuleFaint}" BorderThickness="0,0,0,1"
                            Padding="4,8">
                      <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding Title}" FontWeight="Medium" />
                          <TextBlock Classes="meta" Text="{Binding TimeText}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <Button Classes="primary" Height="26" Padding="10,0" Content="Done"
                                  Command="{Binding RecordDoneCommand}" />
                          <Button Height="26" Padding="10,0" Content="Needs more time"
                                  Command="{Binding RecordNeedsMoreTimeCommand}" />
                          <Button Height="26" Padding="10,0" Content="Didn't happen"
                                  Command="{Binding RecordDidntHappenCommand}" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Flyout>
          </Button.Flyout>
        </Button>
      </StackPanel>
    </Border>

    <!-- Timeline surface (Today: one lane, Week: seven) -->
    <Panel>
      <views:TimelineSurfaceView />

      <!-- Floating plan-draft summary: the calendar remains the review surface -->
      <Border Width="308" HorizontalAlignment="Right" VerticalAlignment="Top"
              Margin="0,16,18,0"
              IsVisible="{Binding HasDraft}"
              Background="{StaticResource BrushPaperWhite}"
              BorderBrush="{StaticResource BrushBorderStrong}" BorderThickness="1"
              CornerRadius="{StaticResource RadiusDrawer}"
              BoxShadow="{StaticResource ShadowPanel}"
              Padding="18,16">
        <StackPanel Spacing="10">
          <TextBlock Text="{Binding DraftTitle}" FontSize="{StaticResource TextSizeBodyLarge}"
                     FontWeight="SemiBold" />
          <TextBlock Text="{Binding DraftSummaryText}" FontSize="{StaticResource TextSizeSmall}"
                     TextWrapping="Wrap" LineHeight="19" />
          <TextBlock Classes="meta" Text="{Binding DraftLeftoverNote}"
                     IsVisible="{Binding HasDraftLeftoverNote}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
            <Button Classes="primary" Content="Approve plan"
                    Command="{Binding ApproveDraftCommand}" />
            <Button Content="Discard draft"
                    Command="{Binding DiscardDraftCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- 10-second undo toast after approval -->
      <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18"
              IsVisible="{Binding IsUndoToastVisible}"
              Background="{StaticResource BrushGraphite}"
              CornerRadius="{StaticResource RadiusPanel}"
              BoxShadow="{StaticResource ShadowPanel}"
              Padding="16,9">
        <StackPanel Orientation="Horizontal" Spacing="14">
          <TextBlock Text="{Binding UndoToastText}"
                     Foreground="{StaticResource BrushPaperWhite}" VerticalAlignment="Center" />
          <Button Content="Undo" Height="26" Padding="12,0" FontWeight="SemiBold"
                  Background="{StaticResource BrushHighlighterLime}"
                  BorderBrush="{StaticResource BrushHighlighterLime}"
                  Command="{Binding UndoLastApprovalCommand}"
                  AutomationProperties.Name="Undo approval" />
        </StackPanel>
      </Border>
    </Panel>

  </DockPanel>

  <!-- Commitment editor: the one shared New/Edit form, centered over the calendar.
       The scrim blocks every background calendar interaction while it is open. -->
  <Border Name="CommitmentModalScrim"
          Background="{StaticResource BrushGraphite40}"
          IsVisible="{Binding IsCommitmentEditorOpen}"
          KeyDown="OnCommitmentModalKeyDown">
    <ContentControl Content="{Binding CommitmentEditor}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Margin="24">
      <ContentControl.ContentTemplate>
        <DataTemplate x:DataType="vm:CommitmentEditorViewModel">
          <Border Name="CommitmentModalCard" Width="408"
                  Background="{StaticResource BrushPaperWhite}"
                  BorderBrush="{StaticResource BrushBorderStrong}" BorderThickness="1"
                  CornerRadius="{StaticResource RadiusDrawer}"
                  BoxShadow="{StaticResource ShadowDrawer}"
                  AutomationProperties.Name="{Binding Heading}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="26,22,26,20" Spacing="14">
                <TextBlock Name="CommitmentEditorHeading" Text="{Binding Heading}"
                           FontSize="{StaticResource TextSizeHeading}" FontWeight="SemiBold" />

                <StackPanel Spacing="6">
                  <TextBlock Classes="metaLabel" Text="TITLE" />
                  <TextBox Name="CommitmentTitleBox" Text="{Binding Title}"
                           PlaceholderText="What is it?"
                           AutomationProperties.Name="Commitment title" />
                </StackPanel>

                <StackPanel Spacing="6">
                  <TextBlock Classes="metaLabel" Text="PROJECT" />
                  <ComboBox Name="CommitmentProjectSelector"
                            ItemsSource="{Binding ProjectOptions}"
                            SelectedItem="{Binding SelectedProject}"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Project">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:ProjectOptionViewModel">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Border Width="10" Height="10" CornerRadius="3"
                                  Background="{Binding AccentBrush}"
                                  IsVisible="{Binding HasAccent}"
                                  VerticalAlignment="Center" />
                          <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                        </StackPanel>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Classes="meta" Text="Create projects from Projects."
                             IsVisible="{Binding !HasProjects}" />
                </StackPanel>

                <StackPanel Spacing="6">
                  <TextBlock Classes="metaLabel" Text="DATE" />
                  <DatePicker SelectedDate="{Binding Date}" HorizontalAlignment="Stretch"
                              AutomationProperties.Name="Commitment date" />
                </StackPanel>

                <Grid ColumnDefinitions="*,14,*">
                  <StackPanel Grid.Column="0" Spacing="6">
                    <TextBlock Classes="metaLabel" Text="START" />
                    <TimePicker SelectedTime="{Binding Start}" ClockIdentifier="12HourClock"
                                HorizontalAlignment="Stretch" MinWidth="0"
                                AutomationProperties.Name="Start time" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="6">
                    <TextBlock Classes="metaLabel" Text="END" />
                    <TimePicker SelectedTime="{Binding End}" ClockIdentifier="12HourClock"
                                HorizontalAlignment="Stretch" MinWidth="0"
                                AutomationProperties.Name="End time" />
                  </StackPanel>
                </Grid>

                <StackPanel Spacing="8">
                  <CheckBox IsChecked="{Binding RepeatsWeekly}" Content="Repeats weekly" />
                  <ItemsControl ItemsSource="{Binding Days}" IsVisible="{Binding RepeatsWeekly}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="4" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:DayToggleViewModel">
                        <ToggleButton Classes="rail" Width="32" Height="26" CornerRadius="4"
                                      IsChecked="{Binding IsSelected}"
                                      AutomationProperties.Name="{Binding Day}">
                          <TextBlock Classes="meta" Text="{Binding Label}"
                                     Foreground="{StaticResource BrushGraphite}" />
                        </ToggleButton>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <!-- Completion state (Edit mode only); new commitments start incomplete -->
                <StackPanel Spacing="4" IsVisible="{Binding IsEditMode}">
                  <CheckBox Name="CommitmentCompletedBox" IsChecked="{Binding IsCompleted}"
                            Content="Completed"
                            AutomationProperties.Name="Completed" />
                  <TextBlock Classes="meta" Text="{Binding CompletionScopeNote}"
                             Margin="28,0,0,0"
                             IsVisible="{Binding CompletionScopeNote, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </StackPanel>

                <TextBlock Foreground="{StaticResource BrushInkHover}"
                           FontSize="{StaticResource TextSizeSmall}"
                           Text="{Binding Error}"
                           IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}"
                           TextWrapping="Wrap" />

                <DockPanel Margin="0,6,0,0" IsVisible="{Binding !IsConfirmingDelete}">
                  <Button Name="CommitmentDeleteButton" DockPanel.Dock="Left"
                          Content="{Binding DeleteButtonText}"
                          IsVisible="{Binding IsEditMode}"
                          Command="{Binding RequestDeleteCommand}"
                          AutomationProperties.Name="{Binding DeleteButtonText}" />
                  <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Content="Cancel" Command="{Binding CancelCommand}" />
                    <Button Name="CommitmentSaveButton" Classes="primary"
                            Content="{Binding SaveButtonText}"
                            Command="{Binding SaveCommand}" />
                  </StackPanel>
                </DockPanel>

                <!-- Inline deletion confirmation: errors and confirmations stay in the dialog -->
                <Border IsVisible="{Binding IsConfirmingDelete}"
                        Background="{StaticResource BrushWorkbenchCream}"
                        BorderBrush="{StaticResource BrushRuleMedium}" BorderThickness="1"
                        CornerRadius="{StaticResource RadiusControl}" Padding="12,10">
                  <StackPanel Spacing="10">
                    <TextBlock Text="{Binding DeleteConfirmationText}"
                               FontSize="{StaticResource TextSizeSmall}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                      <Button Content="Keep" Command="{Binding CancelDeleteCommand}" />
                      <Button Name="CommitmentConfirmDeleteButton"
                              Content="{Binding DeleteButtonText}" FontWeight="SemiBold"
                              BorderBrush="{StaticResource BrushBorderEmphasis}"
                              Command="{Binding ConfirmDeleteCommand}"
                              AutomationProperties.Name="{Binding DeleteButtonText, StringFormat='Confirm: {0}'}" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </DataTemplate>
      </ContentControl.ContentTemplate>
    </ContentControl>
  </Border>

  </Panel>

</UserControl>
