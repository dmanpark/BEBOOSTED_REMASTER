<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BeBoosted.Desktop.ViewModels"
             xmlns:views="using:BeBoosted.Desktop.Views"
             x:Class="BeBoosted.Desktop.Views.CalendarView"
             x:DataType="vm:CalendarViewModel">

  <DockPanel>

    <!-- Compact top bar: date navigation and the Today/Week switch -->
    <Border DockPanel.Dock="Top" Height="52"
            BorderBrush="{StaticResource BrushRuleDefault}"
            BorderThickness="0,0,0,1">
      <DockPanel Margin="18,0" VerticalAlignment="Center">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Button Classes="outlineIcon"
                    Command="{Binding GoPreviousCommand}"
                    AutomationProperties.Name="Previous">
              <Path Classes="icon" Data="{StaticResource IconChevronLeft}" Width="12" Height="12"
                    StrokeThickness="1.5" />
            </Button>
            <Button Classes="outlineIcon"
                    Command="{Binding GoNextCommand}"
                    AutomationProperties.Name="Next">
              <Path Classes="icon" Data="{StaticResource IconChevronRight}" Width="12" Height="12"
                    StrokeThickness="1.5" />
            </Button>
          </StackPanel>
          <Button Height="28" Padding="12,0"
                  Command="{Binding GoToTodayCommand}"
                  Content="Today" FontWeight="Medium" Background="Transparent" />
          <TextBlock Text="{Binding HeaderTitle}"
                     FontSize="{StaticResource TextSizeHeading}" FontWeight="SemiBold"
                     VerticalAlignment="Center" />
          <TextBlock Classes="meta" Text="{Binding HeaderMeta}" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10"
                    HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Name="NewCommitmentButton" Height="28" Padding="12,0"
                  Content="New commitment"
                  Command="{Binding PrepareCommitmentEditorCommand}"
                  AutomationProperties.Name="New fixed commitment">
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight" ShowMode="Standard">
                <StackPanel Width="288" Spacing="10" Margin="4">
                  <TextBlock Text="New commitment" FontWeight="SemiBold" />
                  <TextBox Text="{Binding CommitmentTitle}" PlaceholderText="Title"
                           AutomationProperties.Name="Commitment title" />
                  <DockPanel>
                    <TextBlock Classes="metaLabel" Text="DATE" Width="64" VerticalAlignment="Center" />
                    <DatePicker SelectedDate="{Binding CommitmentDate}"
                                AutomationProperties.Name="Commitment date" />
                  </DockPanel>
                  <DockPanel>
                    <TextBlock Classes="metaLabel" Text="START" Width="64" VerticalAlignment="Center" />
                    <TimePicker SelectedTime="{Binding CommitmentStart}" ClockIdentifier="12HourClock"
                                AutomationProperties.Name="Start time" />
                  </DockPanel>
                  <DockPanel>
                    <TextBlock Classes="metaLabel" Text="END" Width="64" VerticalAlignment="Center" />
                    <TimePicker SelectedTime="{Binding CommitmentEnd}" ClockIdentifier="12HourClock"
                                AutomationProperties.Name="End time" />
                  </DockPanel>
                  <CheckBox IsChecked="{Binding CommitmentRepeatsWeekly}" Content="Repeats weekly" />
                  <ItemsControl ItemsSource="{Binding CommitmentDays}"
                                IsVisible="{Binding CommitmentRepeatsWeekly}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="4" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:DayToggleViewModel">
                        <ToggleButton Classes="rail" Width="32" Height="26" CornerRadius="4"
                                      IsChecked="{Binding IsSelected}"
                                      AutomationProperties.Name="{Binding Day}">
                          <TextBlock Classes="meta" Text="{Binding Label}"
                                     Foreground="{StaticResource BrushGraphite}" />
                        </ToggleButton>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Foreground="{StaticResource BrushInkHover}"
                             FontSize="{StaticResource TextSizeSmall}"
                             Text="{Binding CommitmentError}"
                             IsVisible="{Binding CommitmentError, Converter={x:Static ObjectConverters.IsNotNull}}"
                             TextWrapping="Wrap" />
                  <DockPanel Margin="0,4,0,0">
                    <Button DockPanel.Dock="Right" Classes="primary" Content="Add to calendar"
                            Click="OnSaveCommitmentClick" />
                    <TextBlock Classes="meta" Text="shown cream-gray · locked"
                               VerticalAlignment="Center" />
                  </DockPanel>
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>

          <Border Classes="segmentGroup" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <RadioButton Classes="segment" GroupName="calendarView" Content="Today"
                           IsChecked="{Binding IsTodayView}"
                           AutomationProperties.Name="Today view" />
              <Border Width="1" Background="{StaticResource BrushBorderEmphasis}" />
              <RadioButton Classes="segment" GroupName="calendarView" Content="Week"
                           IsChecked="{Binding IsWeekView}"
                           AutomationProperties.Name="Week view" />
            </StackPanel>
          </Border>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Quiet review notice -->
    <Border DockPanel.Dock="Top"
            IsVisible="{Binding HasReviewNotice}"
            Background="{StaticResource BrushWorkbenchCream}"
            BorderBrush="{StaticResource BrushRuleMedium}" BorderThickness="0,0,0,1"
            Padding="18,7">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Text="{Binding ReviewNoticeText}" VerticalAlignment="Center"
                   FontSize="{StaticResource TextSizeSmall}" />
        <Button Height="26" Padding="10,0" Content="Review" FontWeight="SemiBold"
                AutomationProperties.Name="Review blocks needing an outcome">
          <Button.Flyout>
            <Flyout Placement="BottomEdgeAlignedLeft" ShowMode="Standard">
              <ItemsControl ItemsSource="{Binding ReviewBlocks}" Width="316" Margin="2">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:CalendarBlockViewModel">
                    <Border BorderBrush="{StaticResource BrushRuleFaint}" BorderThickness="0,0,0,1"
                            Padding="4,8">
                      <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding Title}" FontWeight="Medium" />
                          <TextBlock Classes="meta" Text="{Binding TimeText}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <Button Classes="primary" Height="26" Padding="10,0" Content="Done"
                                  Command="{Binding RecordDoneCommand}" />
                          <Button Height="26" Padding="10,0" Content="Needs more time"
                                  Command="{Binding RecordNeedsMoreTimeCommand}" />
                          <Button Height="26" Padding="10,0" Content="Didn't happen"
                                  Command="{Binding RecordDidntHappenCommand}" />
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Flyout>
          </Button.Flyout>
        </Button>
      </StackPanel>
    </Border>

    <!-- Timeline surface (Today: one lane, Week: seven) -->
    <Panel>
      <views:TimelineSurfaceView />

      <!-- Floating plan-draft summary: the calendar remains the review surface -->
      <Border Width="308" HorizontalAlignment="Right" VerticalAlignment="Top"
              Margin="0,16,18,0"
              IsVisible="{Binding HasDraft}"
              Background="{StaticResource BrushPaperWhite}"
              BorderBrush="{StaticResource BrushBorderStrong}" BorderThickness="1"
              CornerRadius="{StaticResource RadiusDrawer}"
              BoxShadow="{StaticResource ShadowPanel}"
              Padding="18,16">
        <StackPanel Spacing="10">
          <TextBlock Text="{Binding DraftTitle}" FontSize="{StaticResource TextSizeBodyLarge}"
                     FontWeight="SemiBold" />
          <TextBlock Text="{Binding DraftSummaryText}" FontSize="{StaticResource TextSizeSmall}"
                     TextWrapping="Wrap" LineHeight="19" />
          <TextBlock Classes="meta" Text="{Binding DraftLeftoverNote}"
                     IsVisible="{Binding HasDraftLeftoverNote}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
            <Button Classes="primary" Content="Approve plan"
                    Command="{Binding ApproveDraftCommand}" />
            <Button Content="Discard draft"
                    Command="{Binding DiscardDraftCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- 10-second undo toast after approval -->
      <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18"
              IsVisible="{Binding IsUndoToastVisible}"
              Background="{StaticResource BrushGraphite}"
              CornerRadius="{StaticResource RadiusPanel}"
              BoxShadow="{StaticResource ShadowPanel}"
              Padding="16,9">
        <StackPanel Orientation="Horizontal" Spacing="14">
          <TextBlock Text="{Binding UndoToastText}"
                     Foreground="{StaticResource BrushPaperWhite}" VerticalAlignment="Center" />
          <Button Content="Undo" Height="26" Padding="12,0" FontWeight="SemiBold"
                  Background="{StaticResource BrushHighlighterLime}"
                  BorderBrush="{StaticResource BrushHighlighterLime}"
                  Command="{Binding UndoLastApprovalCommand}"
                  AutomationProperties.Name="Undo approval" />
        </StackPanel>
      </Border>
    </Panel>

  </DockPanel>

</UserControl>
