<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BeBoosted.Desktop.ViewModels"
             xmlns:views="using:BeBoosted.Desktop.Views"
             x:Class="BeBoosted.Desktop.Views.InboxDrawerView"
             x:DataType="vm:InboxViewModel">

  <UserControl.Styles>
    <!-- The rank chip doubles as the re-rank affordance; it keeps the flat lime look -->
    <Style Selector="Button.rankChip">
      <Setter Property="Background" Value="{DynamicResource BrushHighlighterLime}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="5,0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.rankChip:pointerover">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource BrushGraphite}" />
    </Style>
  </UserControl.Styles>

  <DockPanel>

    <!-- Fast capture -->
    <Border DockPanel.Dock="Top" Margin="14,0,14,10" Height="36"
            BorderBrush="{StaticResource BrushBorderDefault}" BorderThickness="1"
            CornerRadius="{StaticResource RadiusButton}"
            Background="{StaticResource BrushPaperWhite}">
      <DockPanel Margin="12,0,8,0">
        <Path DockPanel.Dock="Left" Classes="icon" Data="{StaticResource IconPlus}"
              Width="12" Height="12" StrokeThickness="1.5"
              Stroke="{StaticResource BrushPencilGray}" VerticalAlignment="Center" />
        <TextBox Name="CaptureBox"
                 Margin="4,0,0,0"
                 Text="{Binding CaptureText}"
                 PlaceholderText="Add a task…"
                 BorderThickness="0" Background="Transparent"
                 VerticalContentAlignment="Center"
                 FontSize="{StaticResource TextSizeSmall}"
                 AutomationProperties.Name="Add a task">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding CaptureCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
      </DockPanel>
    </Border>

    <!-- Empty state -->
    <StackPanel DockPanel.Dock="Top" Margin="16,18,16,24" Spacing="6"
                IsVisible="{Binding !HasTasks}">
      <TextBlock Text="Your Inbox is empty." FontWeight="Medium" />
      <TextBlock Classes="secondary" Text="Captured tasks will wait here until they are planned."
                 FontSize="{StaticResource TextSizeSmall}" TextWrapping="Wrap" />
    </StackPanel>

    <!-- Task queue -->
    <ScrollViewer IsVisible="{Binding HasTasks}">
      <Border BorderBrush="{StaticResource BrushRuleLight}" BorderThickness="0,1,0,0">
        <ItemsControl ItemsSource="{Binding Tasks}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:TaskRowViewModel">
              <Border BorderBrush="{StaticResource BrushRuleFaint}" BorderThickness="0,0,0,1"
                      Padding="16,11" Background="Transparent"
                      PointerPressed="OnRowPointerPressed"
                      PointerMoved="OnRowPointerMoved"
                      PointerReleased="OnRowPointerReleased">
                <DockPanel>
                  <Button DockPanel.Dock="Left" Classes="icon"
                          Width="22" Height="22" CornerRadius="11"
                          BorderBrush="{StaticResource BrushBorderStrong}" BorderThickness="1.5"
                          Command="{Binding CompleteCommand}"
                          AutomationProperties.Name="{Binding Title, StringFormat='Mark {0} done'}"
                          ToolTip.Tip="Mark done"
                          VerticalAlignment="Center" />
                  <!-- Opens the one canonical Task editor — no separate inbox form. -->
                  <Button DockPanel.Dock="Right" Classes="icon"
                          VerticalAlignment="Center"
                          Command="{Binding EditCommand}"
                          AutomationProperties.Name="{Binding Title, StringFormat='Edit task {0}'}"
                          ToolTip.Tip="Edit task">
                    <Path Classes="icon" Data="{StaticResource IconEdit}" Width="13" Height="13"
                          StrokeThickness="1.3" Stroke="{StaticResource BrushPencilGray}" />
                  </Button>
                  <StackPanel Margin="10,0,8,0" Spacing="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                      <TextBlock Text="{Binding Title}" FontWeight="Medium" TextWrapping="Wrap" />
                      <Button Classes="rankChip" IsVisible="{Binding HasRank}"
                              Command="{Binding RerankCommand}"
                              AutomationProperties.Name="{Binding Title, StringFormat='Re-rank {0}'}"
                              ToolTip.Tip="Rank for the current planning period — click to re-rank">
                        <TextBlock Classes="mono" Text="{Binding RankText}"
                                   FontSize="{StaticResource TextSizeMeta}" FontWeight="SemiBold" />
                      </Button>
                      <Border Background="{StaticResource BrushLimeWash}"
                              BorderBrush="{StaticResource BrushBorderDefault}" BorderThickness="1"
                              CornerRadius="3" Padding="5,0" VerticalAlignment="Center"
                              IsVisible="{Binding IsAiOrigin}"
                              ToolTip.Tip="Created by BeBoosted — provenance retained">
                        <TextBlock Classes="meta" Text="AI added"
                                   Foreground="{StaticResource BrushGraphite}" />
                      </Border>
                      <Border Background="{StaticResource BrushWorkbenchCream}"
                              BorderBrush="{StaticResource BrushBorderStrong}" BorderThickness="1"
                              CornerRadius="3" Padding="5,0" VerticalAlignment="Center"
                              IsVisible="{Binding NeedsReview}"
                              ToolTip.Tip="A source this task was based on changed or was removed">
                        <TextBlock Classes="meta" Text="Needs review" />
                      </Border>
                    </StackPanel>
                    <TextBlock Classes="meta" Text="{Binding MetaText}"
                               IsVisible="{Binding HasMeta}" />
                  </StackPanel>
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
    </ScrollViewer>

  </DockPanel>

</UserControl>
