<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BeBoosted.Desktop.ViewModels"
        xmlns:views="using:BeBoosted.Desktop.Views"
        x:Class="BeBoosted.Desktop.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="BeBoosted"
        Width="1440" Height="960"
        MinWidth="1100" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushWorkbenchCream}"
        FontFamily="{StaticResource FontUi}">

  <Window.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CloseInboxCommand}" />
  </Window.KeyBindings>

  <Grid ColumnDefinitions="52,*">

    <!-- Icon rail -->
    <Border Grid.Column="0"
            BorderBrush="{StaticResource BrushRuleDefault}"
            BorderThickness="0,0,1,0">
      <DockPanel LastChildFill="False" Margin="0,12,0,14">
        <StackPanel DockPanel.Dock="Top" Spacing="4" HorizontalAlignment="Center">
          <Border Width="30" Height="30" Background="{StaticResource BrushGraphite}"
                  Margin="0,0,0,14" HorizontalAlignment="Center">
            <TextBlock Text="B"
                       FontFamily="{StaticResource FontMono}"
                       FontWeight="SemiBold" FontSize="15"
                       Foreground="{StaticResource BrushHighlighterLime}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>

          <RadioButton Classes="rail" GroupName="railSections"
                       IsChecked="{Binding IsCalendarActive, Mode=OneWay}"
                       Command="{Binding NavigateCommand}"
                       CommandParameter="{x:Static vm:AppSection.Calendar}"
                       AutomationProperties.Name="Calendar"
                       ToolTip.Tip="Calendar">
            <Path Classes="icon" Data="{StaticResource IconCalendar}" Width="20" Height="20" />
          </RadioButton>

          <ToggleButton Classes="rail"
                        IsChecked="{Binding IsInboxOpen}"
                        AutomationProperties.Name="Inbox"
                        ToolTip.Tip="Inbox">
            <Panel>
              <Path Classes="icon" Data="{StaticResource IconInbox}" Width="20" Height="20" />
              <Border IsVisible="{Binding Inbox.HasTasks}"
                      Background="{StaticResource BrushHighlighterLime}"
                      BorderBrush="{StaticResource BrushGraphite}" BorderThickness="1"
                      MinWidth="16" Height="16" CornerRadius="8"
                      HorizontalAlignment="Right" VerticalAlignment="Top"
                      Margin="0,-6,-8,0" Padding="3,0">
                <TextBlock Text="{Binding Inbox.OpenCount}"
                           FontFamily="{StaticResource FontMono}" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource BrushGraphite}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Panel>
          </ToggleButton>

          <RadioButton Classes="rail" GroupName="railSections"
                       IsChecked="{Binding IsProjectsActive, Mode=OneWay}"
                       Command="{Binding NavigateCommand}"
                       CommandParameter="{x:Static vm:AppSection.Projects}"
                       AutomationProperties.Name="Projects"
                       ToolTip.Tip="Projects">
            <Path Classes="icon" Data="{StaticResource IconProjects}" Width="20" Height="20" />
          </RadioButton>
        </StackPanel>

        <RadioButton DockPanel.Dock="Bottom" Classes="rail" GroupName="railSections"
                     HorizontalAlignment="Center"
                     IsChecked="{Binding IsSettingsActive, Mode=OneWay}"
                     Command="{Binding NavigateCommand}"
                     CommandParameter="{x:Static vm:AppSection.Settings}"
                     AutomationProperties.Name="Settings"
                     ToolTip.Tip="Settings">
          <Path Classes="icon" Data="{StaticResource IconSettings}" Width="20" Height="20" />
        </RadioButton>
      </DockPanel>
    </Border>

    <!-- Main column -->
    <Grid Grid.Column="1" RowDefinitions="*,Auto">

      <ContentControl Grid.Row="0" Content="{Binding CurrentSection}" />

      <!-- Inbox drawer: floats over the current surface, never reflows the calendar. -->
      <Border Grid.Row="0"
              Name="InboxDrawer"
              IsVisible="{Binding IsInboxOpen}"
              Width="372" MaxHeight="520"
              HorizontalAlignment="Left" VerticalAlignment="Top"
              Margin="14,74,0,0"
              Background="{StaticResource BrushPaperWhite}"
              BorderBrush="{StaticResource BrushBorderDefault}"
              BorderThickness="1"
              CornerRadius="{StaticResource RadiusDrawer}"
              BoxShadow="{StaticResource ShadowDrawer}">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="16,13,14,10">
            <TextBlock Text="Inbox" FontSize="{StaticResource TextSizeHeading}" FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <TextBlock Classes="meta" Margin="8,0,0,0" VerticalAlignment="Center"
                       IsVisible="{Binding Inbox.HasTasks}"
                       Text="{Binding Inbox.OpenCount, StringFormat='{}{0} unscheduled'}" />
            <Button DockPanel.Dock="Right" Classes="icon" HorizontalAlignment="Right"
                    Command="{Binding CloseInboxCommand}"
                    AutomationProperties.Name="Close Inbox">
              <Path Classes="icon" Data="{StaticResource IconClose}" Width="12" Height="12"
                    Stroke="{StaticResource BrushPencilGray}" StrokeThickness="1.5" />
            </Button>
          </DockPanel>
          <views:InboxDrawerView Name="InboxDrawerContent" DataContext="{Binding Inbox}" Margin="0,0,0,12" />
        </DockPanel>
      </Border>

      <!-- Collapsed chatbot composer (inert until the AI phase; kept visible per the design). -->
      <Border Grid.Row="1" Margin="16,10,16,14"
              Height="44"
              Background="{StaticResource BrushPaperWhite}"
              BorderBrush="{StaticResource BrushBorderDefault}"
              BorderThickness="1"
              CornerRadius="{StaticResource RadiusPanel}"
              BoxShadow="{StaticResource ShadowSubtle}"
              AutomationProperties.Name="BeBoosted composer (not yet available)">
        <DockPanel Margin="14,0" VerticalAlignment="Center">
          <Border DockPanel.Dock="Left" Width="22" Height="22"
                  Background="{StaticResource BrushHighlighterLime}"
                  CornerRadius="5" VerticalAlignment="Center">
            <Path Classes="icon" Data="{StaticResource IconSpark}" Width="12" Height="12"
                  StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Margin="11,0,0,0" VerticalAlignment="Center"
                     Classes="secondary"
                     Text="Tell BeBoosted what you need…" />
        </DockPanel>
      </Border>

    </Grid>
  </Grid>

</Window>
