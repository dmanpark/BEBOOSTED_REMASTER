<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BeBoosted.Desktop.ViewModels"
        xmlns:views="using:BeBoosted.Desktop.Views"
        x:Class="BeBoosted.Desktop.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="BeBoosted"
        Width="1440" Height="960"
        MinWidth="1100" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BrushWorkbenchCream}"
        FontFamily="{StaticResource FontUi}">

  <Window.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding EscapePressedCommand}" />
    <KeyBinding Gesture="Ctrl+Z" Command="{Binding UndoApprovalCommand}" />
    <KeyBinding Gesture="Meta+Z" Command="{Binding UndoApprovalCommand}" />
    <KeyBinding Gesture="Ctrl+J" Command="{Binding FocusComposerCommand}" />
    <KeyBinding Gesture="Meta+J" Command="{Binding FocusComposerCommand}" />
  </Window.KeyBindings>

  <Panel>
  <Grid ColumnDefinitions="52,*">

    <!-- Icon rail -->
    <Border Grid.Column="0"
            BorderBrush="{StaticResource BrushRuleDefault}"
            BorderThickness="0,0,1,0">
      <DockPanel LastChildFill="False" Margin="0,12,0,14">
        <StackPanel DockPanel.Dock="Top" Spacing="4" HorizontalAlignment="Center">
          <Border Width="30" Height="30" Background="{StaticResource BrushGraphite}"
                  Margin="0,0,0,14" HorizontalAlignment="Center">
            <TextBlock Text="B"
                       FontFamily="{StaticResource FontMono}"
                       FontWeight="SemiBold" FontSize="15"
                       Foreground="{StaticResource BrushHighlighterLime}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>

          <RadioButton Classes="rail" GroupName="railSections"
                       IsChecked="{Binding IsCalendarActive, Mode=OneWay}"
                       Command="{Binding NavigateCommand}"
                       CommandParameter="{x:Static vm:AppSection.Calendar}"
                       AutomationProperties.Name="Calendar"
                       ToolTip.Tip="Calendar">
            <Path Classes="icon" Data="{StaticResource IconCalendar}" Width="20" Height="20" />
          </RadioButton>

          <ToggleButton Classes="rail"
                        IsChecked="{Binding IsInboxOpen}"
                        AutomationProperties.Name="Inbox"
                        ToolTip.Tip="Inbox">
            <Panel>
              <Path Classes="icon" Data="{StaticResource IconInbox}" Width="20" Height="20" />
              <Border IsVisible="{Binding Inbox.HasTasks}"
                      Background="{StaticResource BrushHighlighterLime}"
                      BorderBrush="{StaticResource BrushGraphite}" BorderThickness="1"
                      MinWidth="16" Height="16" CornerRadius="8"
                      HorizontalAlignment="Right" VerticalAlignment="Top"
                      Margin="0,-6,-8,0" Padding="3,0">
                <TextBlock Text="{Binding Inbox.OpenCount}"
                           FontFamily="{StaticResource FontMono}" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource BrushGraphite}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </Panel>
          </ToggleButton>

          <RadioButton Classes="rail" GroupName="railSections"
                       IsChecked="{Binding IsProjectsActive, Mode=OneWay}"
                       Command="{Binding NavigateCommand}"
                       CommandParameter="{x:Static vm:AppSection.Projects}"
                       AutomationProperties.Name="Projects"
                       ToolTip.Tip="Projects">
            <Path Classes="icon" Data="{StaticResource IconProjects}" Width="20" Height="20" />
          </RadioButton>
        </StackPanel>

        <RadioButton DockPanel.Dock="Bottom" Classes="rail" GroupName="railSections"
                     HorizontalAlignment="Center"
                     IsChecked="{Binding IsSettingsActive, Mode=OneWay}"
                     Command="{Binding NavigateCommand}"
                     CommandParameter="{x:Static vm:AppSection.Settings}"
                     AutomationProperties.Name="Settings"
                     ToolTip.Tip="Settings">
          <Path Classes="icon" Data="{StaticResource IconSettings}" Width="20" Height="20" />
        </RadioButton>
      </DockPanel>
    </Border>

    <!-- Main column -->
    <Grid Grid.Column="1" RowDefinitions="*,Auto">

      <ContentControl Grid.Row="0" Content="{Binding CurrentSection}" />

      <!-- Inbox drawer: floats over the current surface, never reflows the calendar. -->
      <Border Grid.Row="0"
              Name="InboxDrawer"
              IsVisible="{Binding IsInboxOpen}"
              Width="372" MaxHeight="520"
              HorizontalAlignment="Left" VerticalAlignment="Top"
              Margin="14,74,0,0"
              Background="{StaticResource BrushPaperWhite}"
              BorderBrush="{StaticResource BrushBorderDefault}"
              BorderThickness="1"
              CornerRadius="{StaticResource RadiusDrawer}"
              BoxShadow="{StaticResource ShadowDrawer}">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="16,13,14,10">
            <TextBlock Text="Inbox" FontSize="{StaticResource TextSizeHeading}" FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <TextBlock Classes="meta" Margin="8,0,0,0" VerticalAlignment="Center"
                       IsVisible="{Binding Inbox.HasTasks}"
                       Text="{Binding Inbox.OpenCount, StringFormat='{}{0} unscheduled'}" />
            <Button DockPanel.Dock="Right" Classes="icon" HorizontalAlignment="Right"
                    Command="{Binding CloseInboxCommand}"
                    AutomationProperties.Name="Close Inbox">
              <Path Classes="icon" Data="{StaticResource IconClose}" Width="12" Height="12"
                    Stroke="{StaticResource BrushPencilGray}" StrokeThickness="1.5" />
            </Button>
          </DockPanel>
          <!-- Drawer footer: batch planning entry points -->
          <Border DockPanel.Dock="Bottom"
                  Background="{StaticResource BrushWorkbenchCream}"
                  BorderBrush="{StaticResource BrushRuleDefault}" BorderThickness="0,1,0,0"
                  Padding="14,12" CornerRadius="0,0,10,10">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Classes="primary" Content="Plan…"
                      Command="{Binding PlanCommand}"
                      ToolTip.Tip="Draft a schedule for the visible period" />
              <Button Content="Priority Sort"
                      Command="{Binding StartPrioritySortCommand}"
                      ToolTip.Tip="Compare tasks two at a time to rank this period" />
              <TextBlock Classes="meta" Text="drag onto the calendar"
                         VerticalAlignment="Center" />
            </StackPanel>
          </Border>
          <views:InboxDrawerView Name="InboxDrawerContent" DataContext="{Binding Inbox}" Margin="0,0,0,12" />
        </DockPanel>
      </Border>

      <!-- Collapsed chatbot composer -->
      <Border Grid.Row="1" Margin="16,10,16,14"
              Height="44"
              Background="{StaticResource BrushPaperWhite}"
              BorderBrush="{StaticResource BrushBorderDefault}"
              BorderThickness="1"
              CornerRadius="{StaticResource RadiusPanel}"
              BoxShadow="{StaticResource ShadowSubtle}"
              IsVisible="{Binding !Chat.IsExpanded}">
        <DockPanel Margin="14,0" VerticalAlignment="Center">
          <Border DockPanel.Dock="Left" Width="22" Height="22"
                  Background="{StaticResource BrushHighlighterLime}"
                  CornerRadius="5" VerticalAlignment="Center">
            <Path Classes="icon" Data="{StaticResource IconSpark}" Width="12" Height="12"
                  StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <Border DockPanel.Dock="Right"
                  BorderBrush="{StaticResource BrushRuleMedium}" BorderThickness="1"
                  CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
            <TextBlock Classes="meta" Text="{Binding ComposerShortcutText}" />
          </Border>
          <TextBox Name="ComposerInput" Margin="7,0,10,0" VerticalAlignment="Center"
                   Text="{Binding Chat.InputText}"
                   PlaceholderText="{Binding Chat.Placeholder}"
                   BorderThickness="0" Background="Transparent"
                   VerticalContentAlignment="Center"
                   AutomationProperties.Name="BeBoosted composer">
            <TextBox.KeyBindings>
              <KeyBinding Gesture="Enter" Command="{Binding Chat.SubmitCommand}" />
            </TextBox.KeyBindings>
          </TextBox>
        </DockPanel>
      </Border>

      <!-- Expanded chat: temporary, over the current surface (frame 07) -->
      <Border Grid.Row="0" Grid.RowSpan="2" Margin="100,120,100,0"
              IsVisible="{Binding Chat.IsExpanded}"
              Background="{StaticResource BrushPaperWhite}"
              BorderBrush="{StaticResource BrushBorderStrong}" BorderThickness="1,1,1,0"
              CornerRadius="12,12,0,0"
              BoxShadow="{StaticResource ShadowDrawer}">
        <DockPanel>
          <Border DockPanel.Dock="Top" Padding="22,14,18,10"
                  BorderBrush="{StaticResource BrushRuleLight}" BorderThickness="0,0,0,1">
            <DockPanel>
              <StackPanel Orientation="Horizontal" Spacing="9">
                <Border Width="22" Height="22" Background="{StaticResource BrushHighlighterLime}"
                        CornerRadius="5">
                  <Path Classes="icon" Data="{StaticResource IconSpark}" Width="12" Height="12"
                        StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="BeBoosted" FontWeight="SemiBold"
                           FontSize="{StaticResource TextSizeBodyLarge}" VerticalAlignment="Center" />
                <TextBlock Classes="meta" Text="temporary — collapses on close"
                           VerticalAlignment="Center" />
              </StackPanel>
              <Button DockPanel.Dock="Right" Classes="icon" HorizontalAlignment="Right"
                      Command="{Binding Chat.CollapseCommand}"
                      AutomationProperties.Name="Close chat">
                <Path Classes="icon" Data="{StaticResource IconClose}" Width="12" Height="12"
                      Stroke="{StaticResource BrushPencilGray}" StrokeThickness="1.5" />
              </Button>
            </DockPanel>
          </Border>

          <Border DockPanel.Dock="Bottom" Padding="22,10,22,16">
            <Border Height="44" BorderBrush="{StaticResource BrushBorderStrong}" BorderThickness="1"
                    CornerRadius="{StaticResource RadiusPanel}">
              <DockPanel Margin="14,0,6,0">
                <Button DockPanel.Dock="Right" Width="28" Height="28" Padding="0"
                        Background="{StaticResource BrushGraphite}" CornerRadius="6"
                        VerticalAlignment="Center"
                        Command="{Binding Chat.SubmitCommand}"
                        AutomationProperties.Name="Send">
                  <Path Data="M6,10 L6,2 M2.5,5.5 L6,2 L9.5,5.5" Stroke="{StaticResource BrushHighlighterLime}"
                        StrokeThickness="1.6" Fill="{x:Null}" Width="12" Height="12" />
                </Button>
                <TextBox Name="ChatInput" VerticalAlignment="Center" Margin="0,0,8,0"
                         Text="{Binding Chat.InputText}"
                         PlaceholderText="Reply or adjust…"
                         BorderThickness="0" Background="Transparent"
                         VerticalContentAlignment="Center"
                         AutomationProperties.Name="Chat message">
                  <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding Chat.SubmitCommand}" />
                  </TextBox.KeyBindings>
                </TextBox>
              </DockPanel>
            </Border>
          </Border>

          <ScrollViewer Name="ChatScroll" Padding="26,18">
            <ItemsControl ItemsSource="{Binding Chat.Items}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Spacing="16" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.DataTemplates>

                <DataTemplate DataType="vm:ChatUserMessageViewModel">
                  <Border HorizontalAlignment="Right" MaxWidth="560"
                          Background="{StaticResource BrushWorkbenchCream}"
                          BorderBrush="{StaticResource BrushRuleMedium}" BorderThickness="1"
                          CornerRadius="{StaticResource RadiusPanel}" Padding="14,10">
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" LineHeight="20"
                               FontSize="{StaticResource TextSizeBodyLarge}" />
                  </Border>
                </DataTemplate>

                <DataTemplate DataType="vm:ChatAssistantMessageViewModel">
                  <StackPanel MaxWidth="640" HorizontalAlignment="Left" Spacing="8">
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" LineHeight="21"
                               FontSize="{StaticResource TextSizeBodyLarge}" />
                    <ItemsControl ItemsSource="{Binding Citations}" IsVisible="{Binding HasCitations}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:CitationChipViewModel">
                          <Button Height="24" Padding="8,0" Margin="0,0,6,6"
                                  Command="{Binding OpenCommand}"
                                  AutomationProperties.Name="{Binding Label, StringFormat='Open source {0}'}">
                            <TextBlock Classes="mono" Text="{Binding Label}"
                                       FontSize="{StaticResource TextSizeMeta}" />
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>

                <DataTemplate DataType="vm:ChatReviewItemViewModel">
                  <StackPanel MaxWidth="640" HorizontalAlignment="Left" Spacing="10">
                    <TextBlock Text="{Binding HeaderText}" TextWrapping="Wrap"
                               FontSize="{StaticResource TextSizeBodyLarge}"
                               IsVisible="{Binding IsPending}" />
                    <Border BorderBrush="{StaticResource BrushRuleMedium}" BorderThickness="1"
                            CornerRadius="{StaticResource RadiusPanel}" ClipToBounds="True"
                            IsVisible="{Binding IsPending}">
                      <ItemsControl ItemsSource="{Binding Drafts}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="vm:DraftRowViewModel">
                            <Border Background="{StaticResource BrushLimeWash}"
                                    BorderBrush="{StaticResource BrushRuleLight}"
                                    BorderThickness="0,0,0,1" Padding="15,10">
                              <DockPanel>
                                <Border DockPanel.Dock="Left"
                                        Background="{StaticResource BrushPaperWhite}"
                                        BorderBrush="{StaticResource BrushBorderEmphasis}"
                                        BorderThickness="1" CornerRadius="3" Padding="5,1"
                                        VerticalAlignment="Center">
                                  <TextBlock Classes="meta" Text="AI suggested"
                                             Foreground="{StaticResource BrushGraphite}" />
                                </Border>
                                <Button DockPanel.Dock="Right" Classes="icon"
                                        Command="{Binding DismissCommand}"
                                        AutomationProperties.Name="{Binding EditTitle, StringFormat='Dismiss {0}'}"
                                        ToolTip.Tip="Dismiss" VerticalAlignment="Center">
                                  <Path Classes="icon" Data="{StaticResource IconClose}" Width="11"
                                        Height="11" Stroke="{StaticResource BrushPencilGray}"
                                        StrokeThickness="1.5" />
                                </Button>
                                <StackPanel Margin="11,0" Spacing="3" VerticalAlignment="Center">
                                  <TextBox Text="{Binding EditTitle}" FontWeight="SemiBold"
                                           BorderThickness="0" Background="Transparent" Padding="0"
                                           MinHeight="0"
                                           AutomationProperties.Name="Proposed task title" />
                                  <TextBlock Classes="meta" Text="{Binding MetaText}" />
                                </StackPanel>
                              </DockPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsPending}">
                      <Button Classes="primary" Content="{Binding AddAllLabel}"
                              Command="{Binding AddAllCommand}" />
                      <Button Content="Dismiss all" Command="{Binding DismissAllCommand}" />
                    </StackPanel>
                    <TextBlock Classes="secondary" FontSize="{StaticResource TextSizeSmall}"
                               IsVisible="{Binding IsPending}" TextWrapping="Wrap"
                               Text="You can turn on automatic adding in Settings. Auto-added tasks always keep an AI added label." />
                    <TextBlock Classes="secondary" Text="{Binding ResolutionText}"
                               IsVisible="{Binding !IsPending}" />
                  </StackPanel>
                </DataTemplate>

              </ItemsControl.DataTemplates>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

    </Grid>
  </Grid>

  <!-- Priority Sort: focused, full-screen comparison flow over everything -->
  <Panel IsVisible="{Binding IsSortActive}">
    <views:PrioritySortView DataContext="{Binding ActiveSort}" />
  </Panel>
  </Panel>

</Window>
