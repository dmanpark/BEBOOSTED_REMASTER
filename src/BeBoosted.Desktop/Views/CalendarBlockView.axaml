<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:BeBoosted.Desktop.ViewModels"
             xmlns:controls="using:BeBoosted.Desktop.Controls"
             x:Class="BeBoosted.Desktop.Views.CalendarBlockView"
             x:DataType="vm:CalendarBlockViewModel"
             Focusable="True"
             AutomationProperties.Name="{Binding AccessibleName}">

  <UserControl.Styles>
    <!-- Checked treatment for the occurrence done circle -->
    <Style Selector="Button#OccurrenceDoneButton.checked">
      <Setter Property="Background" Value="{DynamicResource BrushHighlighterLime}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BrushGraphite}" />
    </Style>
    <!-- The source block keeps a lime halo behind the scrim while edited (frame 3b).
         The literal equals ColorLimeHalo — BoxShadows cannot compose a resource color. -->
    <Style Selector="Border#BlockBorder.editing">
      <Setter Property="BorderBrush" Value="{DynamicResource BrushGraphite}" />
      <Setter Property="BoxShadow" Value="0 0 0 3 #8CC8F24A" />
    </Style>
  </UserControl.Styles>

  <Border Name="BlockBorder"
          Classes="calendarBlock"
          Classes.external="{Binding IsExternal}"
          Classes.done="{Binding IsDone}"
          Classes.conflict="{Binding IsConflicted}"
          Classes.proposal="{Binding IsProposal}"
          Classes.editing="{Binding IsBeingEdited}">
    <Grid>
      <DockPanel Margin="0">
        <!-- project-accent edge (task blocks only) -->
        <Border DockPanel.Dock="Left" Width="3"
                Background="{StaticResource BrushAccentSlate}"
                IsVisible="{Binding IsSession}" />
        <Grid Margin="8,5,8,5" RowDefinitions="Auto,*" ColumnDefinitions="Auto,*">
          <!-- Outcome control (approved task blocks) -->
          <Button Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                  Name="CompleteButton"
                  Classes="icon" Width="20" Height="20" CornerRadius="10"
                  Margin="0,1,8,0" VerticalAlignment="Top"
                  BorderBrush="{StaticResource BrushBorderStrong}" BorderThickness="1.5"
                  IsVisible="{Binding ShowCompletionControl}"
                  AutomationProperties.Name="{Binding Title, StringFormat='Record outcome for {0}'}"
                  ToolTip.Tip="Record outcome">
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedLeft" ShowMode="Standard">
                <StackPanel Width="228" Spacing="6" Margin="2">
                  <Button Classes="primary" HorizontalAlignment="Stretch"
                          Content="Done"
                          Command="{Binding RecordDoneCommand}"
                          Click="OnFlyoutActionClick" />
                  <Border BorderBrush="{StaticResource BrushRuleMedium}" BorderThickness="1"
                          CornerRadius="{StaticResource RadiusControl}" Padding="8,7">
                    <StackPanel Spacing="6">
                      <TextBlock Text="Needs more time" FontWeight="Medium" />
                      <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Save" Margin="6,0,0,0"
                                Command="{Binding RecordNeedsMoreTimeCommand}"
                                Click="OnFlyoutActionClick" />
                        <NumericUpDown Value="{Binding RemainingMinutes}" Minimum="5" Maximum="720"
                                       Increment="5" FormatString="0"
                                       AutomationProperties.Name="Remaining minutes" />
                      </DockPanel>
                      <TextBlock Classes="meta" Text="returns to Inbox with the time left" />
                    </StackPanel>
                  </Border>
                  <Button HorizontalAlignment="Stretch" Content="Didn't happen"
                          Command="{Binding RecordDidntHappenCommand}"
                          Click="OnFlyoutActionClick" />
                  <Button HorizontalAlignment="Stretch" Content="Remove from calendar"
                          Command="{Binding UnscheduleCommand}"
                          Click="OnFlyoutActionClick" />
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>

          <!-- Occurrence circle (repeating task sessions): one click marks this
               day done, another reopens — never opens the editor. -->
          <Button Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                  Name="OccurrenceDoneButton"
                  Classes="icon" Classes.checked="{Binding IsDone}"
                  Width="20" Height="20" CornerRadius="10"
                  Margin="0,1,8,0" VerticalAlignment="Top"
                  BorderBrush="{StaticResource BrushBorderStrong}" BorderThickness="1.5"
                  IsVisible="{Binding ShowOccurrenceCompletionControl}"
                  Command="{Binding ToggleOccurrenceDoneCommand}"
                  AutomationProperties.Name="{Binding CompletionControlName}"
                  ToolTip.Tip="{Binding CompletionControlName}">
            <Path Classes="icon" Data="{StaticResource IconCheck}" Width="9" Height="9"
                  StrokeThickness="1.8" IsVisible="{Binding IsDone}" />
          </Button>

          <!-- Draft proposal control: approve / remove / Why? -->
          <Button Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                  Name="ProposalButton"
                  Classes="icon" Width="20" Height="20" CornerRadius="5"
                  Margin="0,1,8,0" VerticalAlignment="Top"
                  Background="{StaticResource BrushHighlighterLime}"
                  IsVisible="{Binding IsProposal}"
                  AutomationProperties.Name="{Binding Title, StringFormat='Proposal actions for {0}'}"
                  ToolTip.Tip="Approve, remove, or see why">
            <Path Classes="icon" Data="{StaticResource IconSpark}" Width="11" Height="11"
                  StrokeThickness="1.4" />
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedLeft" ShowMode="Standard">
                <StackPanel Width="300" Spacing="0" Margin="2">
                  <StackPanel Spacing="3" Margin="4,4,4,10">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Classes="meta" Text="drag to move · edge to resize" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,0,4,12">
                    <Button Classes="primary" Content="Approve this block" Height="30"
                            Command="{Binding ApproveThisCommand}"
                            Click="OnFlyoutActionClick" />
                    <Button Content="Remove" Height="30"
                            Command="{Binding RemoveFromDraftCommand}"
                            Click="OnFlyoutActionClick" />
                  </StackPanel>
                  <!-- Why: user-relevant evidence, never chain-of-thought -->
                  <Border Background="{StaticResource BrushWorkbenchCream}"
                          BorderBrush="{StaticResource BrushRuleDefault}" BorderThickness="0,1,0,0"
                          Margin="-14,0,-14,-14" Padding="18,12,18,16" CornerRadius="0,0,8,8">
                    <StackPanel Spacing="8">
                      <DockPanel IsVisible="{Binding Why.Deadline, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Classes="metaLabel" Text="DEADLINE" Width="88" />
                        <TextBlock Text="{Binding Why.Deadline}" FontSize="{StaticResource TextSizeSmall}"
                                   TextWrapping="Wrap" />
                      </DockPanel>
                      <DockPanel>
                        <TextBlock Classes="metaLabel" Text="DURATION" Width="88" />
                        <TextBlock Text="{Binding Why.Duration}" FontSize="{StaticResource TextSizeSmall}"
                                   TextWrapping="Wrap" />
                      </DockPanel>
                      <DockPanel IsVisible="{Binding Why.Priority, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Classes="metaLabel" Text="PRIORITY" Width="88" />
                        <TextBlock Text="{Binding Why.Priority}" FontSize="{StaticResource TextSizeSmall}"
                                   TextWrapping="Wrap" />
                      </DockPanel>
                      <DockPanel>
                        <TextBlock Classes="metaLabel" Text="OPEN TIME" Width="88" />
                        <TextBlock Text="{Binding Why.Availability}" FontSize="{StaticResource TextSizeSmall}"
                                   TextWrapping="Wrap" />
                      </DockPanel>
                      <DockPanel IsVisible="{Binding Why.Source, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Classes="metaLabel" Text="SOURCE" Width="88" />
                        <Border Background="{StaticResource BrushPaperWhite}"
                                BorderBrush="{StaticResource BrushBorderStrong}" BorderThickness="1"
                                CornerRadius="4" Padding="7,2" HorizontalAlignment="Left">
                          <TextBlock Classes="mono" Text="{Binding Why.Source}"
                                     FontSize="{StaticResource TextSizeMeta}" />
                        </Border>
                      </DockPanel>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>

          <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="6">
            <TextBlock Name="TitleText" Text="{Binding Title}"
                       FontSize="{StaticResource TextSizeSmall}" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Classes="meta" Text="{Binding SessionLabel}"
                       IsVisible="{Binding HasSessionLabel}" VerticalAlignment="Center" />
            <Path Classes="icon" Data="{StaticResource IconLock}" Width="11" Height="11"
                  StrokeThickness="1.2" Stroke="{StaticResource BrushPencilGray}"
                  IsVisible="{Binding IsLocked}" VerticalAlignment="Center"
                  ToolTip.Tip="Synced from an external calendar — BeBoosted never edits it" />
            <Border Background="{StaticResource BrushWorkbenchCream}"
                    BorderBrush="{StaticResource BrushBorderDefault}" BorderThickness="1"
                    CornerRadius="3" Padding="4,0"
                    IsVisible="{Binding NeedsOutcome}">
              <TextBlock Classes="meta" Text="outcome?" />
            </Border>
          </StackPanel>
          <TextBlock Grid.Row="1" Grid.Column="1" Classes="meta"
                     Text="{Binding TimeText}" Margin="0,1,0,0" />
        </Grid>
      </DockPanel>

      <controls:HatchOverlay IsVisible="{Binding IsConflicted}" IsHitTestVisible="False" />

      <!-- Dashed graphite outline: the proposal state signature -->
      <Rectangle Stroke="{StaticResource BrushGraphite55}" StrokeThickness="1.5"
                 StrokeDashArray="3,2" RadiusX="5" RadiusY="5"
                 IsHitTestVisible="False" IsVisible="{Binding IsProposal}" />

      <!-- resize grip (local sessions and proposals) -->
      <Border Name="ResizeGrip" Height="7" VerticalAlignment="Bottom"
              Background="Transparent" Cursor="SizeNorthSouth"
              IsVisible="{Binding CanResize}" />
    </Grid>
  </Border>

</UserControl>
